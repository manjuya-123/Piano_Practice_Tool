<UserControl x:Class="PianoPracticeTool.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Style="{DynamicResource SettingsTabControlStyle}"
                    Foreground="{DynamicResource TextPrimaryBrush}">
            <TabItem Header="MIDI / 音源">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="900">
                        <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="MIDI入力" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="優先デバイス" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox x:Name="MidiDeviceComboBox" Grid.Column="1" Style="{DynamicResource DarkComboBoxStyle}" />
                                    <Button Grid.Column="2" Content="再検出" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="RefreshMidiButton_Click" />
                                </Grid>
                                <CheckBox x:Name="AutoConnectMidiCheckBox"
                                          Content="起動時・再検出時に優先MIDIデバイスへ自動接続"
                                          Margin="170,10,0,0"
                                          Foreground="{DynamicResource TextPrimaryBrush}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="発音先" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox x:Name="MidiOutputDeviceComboBox" Grid.Column="1" Style="{DynamicResource DarkComboBoxStyle}" />
                                </Grid>
                                <TextBlock Margin="170,6,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="内蔵SoundFont音源または外部MIDI OUTを選択できます。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="内蔵SoundFont音源" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SoundFont" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox x:Name="SoundFontPathTextBox"
                                             Grid.Column="1"
                                             Padding="8,6"
                                             IsReadOnly="True"
                                             ToolTip="使用するSoundFont (.sf2)" />
                                    <Button Grid.Column="2"
                                            Content="参照..."
                                            Margin="8,0,0,0"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Click="SoundFontBrowseButton_Click" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="音色 / Preset" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox x:Name="SoundFontPresetComboBox"
                                              Grid.Column="1"
                                              DisplayMemberPath="DisplayName"
                                              Style="{DynamicResource DarkComboBoxStyle}"
                                              SelectionChanged="SoundFontPresetComboBox_SelectionChanged" />
                                </Grid>
                                <TextBlock x:Name="SoundFontPresetStatusText"
                                           Margin="170,6,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}" />

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="内蔵音源ゲイン" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider x:Name="BuiltInSoundFontVolumeSlider" Grid.Column="1" Minimum="0" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="BuiltInSoundFontSlider_ValueChanged" />
                                    <TextBlock x:Name="BuiltInSoundFontVolumeText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="お手本再生の強さ" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider x:Name="AutomaticPlaybackVelocitySlider" Grid.Column="1" Minimum="1" Maximum="127" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="BuiltInSoundFontSlider_ValueChanged" />
                                    <TextBlock x:Name="AutomaticPlaybackVelocityText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="リバーブ" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider x:Name="BuiltInSoundFontReverbSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="BuiltInSoundFontSlider_ValueChanged" />
                                    <TextBlock x:Name="BuiltInSoundFontReverbText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>

                                <TextBlock Margin="170,6,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="任意の .sf2 を選択できます。複数音色入りSoundFontではBank / ProgramごとのPresetを選択します。ピアノ以外の音色も使用できます。SoundFont / Preset / ゲイン / リバーブの変更はその場で試聴でき、保存すると確定します。" />
                                <Button Content="SoundFont音源を試聴"
                                        Margin="170,10,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Click="BuiltInSoundFontTestButton_Click" />
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="鍵盤範囲" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="標準音域" VerticalAlignment="Top" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="KeyboardRangeCaptureButton"
                                                    Content="MIDIから音域を検出"
                                                    Padding="16,8"
                                                    Style="{DynamicResource PrimaryButtonStyle}"
                                                    Click="KeyboardRangeCaptureButton_Click" />
                                            <TextBlock x:Name="KeyboardRangeCaptureStatusText"
                                                       Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="最低音と最高音を実機から取得できます。" />
                                        </Grid>

                                        <WrapPanel Margin="0,12,0,0">
                                            <TextBlock Text="プリセット" Margin="0,0,10,6" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                            <Button Content="88鍵" Tag="21,108" Margin="0,0,6,6" Style="{DynamicResource SecondaryButtonStyle}" Click="KeyboardPresetButton_Click" />
                                            <Button Content="76鍵" Tag="28,103" Margin="0,0,6,6" Style="{DynamicResource SecondaryButtonStyle}" Click="KeyboardPresetButton_Click" />
                                            <Button Content="73鍵" Tag="28,100" Margin="0,0,6,6" Style="{DynamicResource SecondaryButtonStyle}" Click="KeyboardPresetButton_Click" />
                                            <Button Content="61鍵" Tag="36,96" Margin="0,0,6,6" Style="{DynamicResource SecondaryButtonStyle}" Click="KeyboardPresetButton_Click" />
                                            <Button Content="49鍵" Tag="36,84" Margin="0,0,6,6" Style="{DynamicResource SecondaryButtonStyle}" Click="KeyboardPresetButton_Click" />
                                            <Button Content="37鍵" Tag="36,72" Margin="0,0,6,6" Style="{DynamicResource SecondaryButtonStyle}" Click="KeyboardPresetButton_Click" />
                                            <Button Content="25鍵" Tag="48,72" Margin="0,0,6,6" Style="{DynamicResource SecondaryButtonStyle}" Click="KeyboardPresetButton_Click" />
                                        </WrapPanel>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="最低音" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                            <Slider x:Name="KeyboardLowestSlider" Grid.Column="1" Minimum="0" Maximum="127" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="KeyboardRangeSlider_ValueChanged" />
                                            <TextBlock x:Name="KeyboardLowestNoteText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Grid>

                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="最高音" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                            <Slider x:Name="KeyboardHighestSlider" Grid.Column="1" Minimum="0" Maximum="127" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="KeyboardRangeSlider_ValueChanged" />
                                            <TextBlock x:Name="KeyboardHighestNoteText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Grid>

                                        <TextBlock x:Name="KeyboardCountText" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="HasOctaveShiftCheckBox"
                                          Content="MIDIキーボード本体でオクターブシフトを使用できる"
                                          Margin="170,12,0,0"
                                          Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="練習 / 判定">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="900">
                        <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="演奏判定" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="押鍵・離鍵の判定幅をまとめて調整します。中央線が譜面どおりの時刻です。"
                                           Margin="0,6,0,12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="判定幅" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider x:Name="JudgementTimingSlider" Grid.Column="1" Minimum="50" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="JudgementTimingSlider_ValueChanged" />
                                    <TextBlock x:Name="JudgementTimingText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>

                                <Grid Margin="170,14,0,0" Width="520" HorizontalAlignment="Left">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="押鍵" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    <Grid Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}">
                                        <Border x:Name="AttackGoodTimingBand" HorizontalAlignment="Center" Background="{DynamicResource WarningBrush}" Opacity="0.22" />
                                        <Border x:Name="AttackGreatTimingBand" HorizontalAlignment="Center" Background="{DynamicResource AccentBrush}" Opacity="0.32" />
                                        <Border x:Name="AttackPerfectTimingBand" HorizontalAlignment="Center" Background="{DynamicResource SuccessBrush}" Opacity="0.52" />
                                        <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource TextPrimaryBrush}" />
                                    </Grid>
                                    <TextBlock x:Name="AttackTimingText" Grid.Row="2" Margin="0,4,0,10" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Grid Grid.Row="3" Background="{DynamicResource SurfaceRaisedBrush}">
                                        <Border x:Name="ReleaseGoodTimingBand" HorizontalAlignment="Center" Background="{DynamicResource WarningBrush}" Opacity="0.22" />
                                        <Border x:Name="ReleaseGreatTimingBand" HorizontalAlignment="Center" Background="{DynamicResource AccentBrush}" Opacity="0.32" />
                                        <Border x:Name="ReleasePerfectTimingBand" HorizontalAlignment="Center" Background="{DynamicResource SuccessBrush}" Opacity="0.52" />
                                        <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource TextPrimaryBrush}" />
                                    </Grid>
                                    <TextBlock x:Name="ReleaseTimingText" Grid.Row="4" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{DynamicResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="練習音" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="メトロノーム音量" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider x:Name="MetronomeVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="MetronomeVolumeSlider_ValueChanged" />
                                    <TextBlock x:Name="MetronomeVolumeText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="表示">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="900">
                        <Border Style="{DynamicResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="演奏画面" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="表示範囲" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Slider x:Name="PianoRollVisibleRangeSlider"
                                            Grid.Column="1"
                                            Minimum="50"
                                            Maximum="200"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="PianoRollVisibleRangeSlider_ValueChanged" />
                                    <TextBlock x:Name="PianoRollVisibleRangeText"
                                               Grid.Column="2"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </Grid>
                                <TextBlock Margin="170,5,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="テンポや練習速度とは独立。100%で約8 beat（4/4なら約2小節）を表示します。" />
                                <CheckBox x:Name="ShowHandColorsCheckBox"
                                          Content="ロールを右手 / 左手で色分け"
                                          Margin="170,14,0,0"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          Checked="ShowHandColorsCheckBox_Changed"
                                          Unchecked="ShowHandColorsCheckBox_Changed" />
                                <CheckBox x:Name="ShowFingeringCheckBox"
                                          Content="運指番号を表示"
                                          Margin="194,8,0,0"
                                          Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Margin="194,4,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="運指表示は左右色分けを使用している場合だけ有効です。" />
                                <CheckBox x:Name="ShowExpectedKeyboardGuideCheckBox"
                                          Content="鍵盤に次の課題音ガイドを表示"
                                          Margin="170,10,0,0"
                                          Foreground="{DynamicResource TextPrimaryBrush}" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="編集タイムライン"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox x:Name="EditorTimelineDragModeComboBox"
                                              Grid.Column="1"
                                              DisplayMemberPath="Label"
                                              Style="{DynamicResource DarkComboBoxStyle}" />
                                </Grid>
                                <TextBlock Margin="170,6,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="直接追従はドラッグを離した位置で停止します。タッチスクロールは離した速度に応じて短く惰性移動します。" />
                                <CheckBox x:Name="EditorPanPitchEnabledCheckBox"
                                          Margin="170,10,0,0"
                                          Content="編集ピアノロールのAlt / 中ボタンドラッグで音域方向も移動する"
                                          Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Margin="170,4,0,0"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="OFFの場合は時間方向だけを移動します。ONの場合は上下方向の時間移動と左右方向の音域移動を同時に行えます。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="楽曲ライブラリ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="900">
                        <Border Style="{DynamicResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="楽曲ライブラリ" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="起動時に以下のフォルダをサブフォルダまで自動探索します。"
                                           Margin="0,6,0,10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ListBox x:Name="SongFoldersListBox" Height="180" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewSongFolderTextBox" Padding="8,6" ToolTip="探索対象フォルダのフルパス" />
                                    <Button Grid.Column="1" Content="追加" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="AddSongFolderButton_Click" />
                                    <Button Grid.Column="2" Content="選択を削除" Margin="8,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" Click="RemoveSongFolderButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="14,10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,1,1,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Grid.Column="1"
                        Content="設定を保存"
                        MinWidth="130"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Click="SaveButton_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>