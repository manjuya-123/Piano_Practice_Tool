<UserControl x:Class="PianoPracticeTool.Views.ScoreEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PianoPracticeTool.Controls"
             Background="Transparent"
             Focusable="True"
             PreviewKeyDown="ScoreEditorView_PreviewKeyDown"
             PreviewKeyUp="ScoreEditorView_PreviewKeyUp">
    <UserControl.Resources>
        <Style x:Key="EditorIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="650" />
            <Setter Property="ToolTipService.ShowDuration" Value="1600" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="250" />
        </Style>

        <Style x:Key="EditorEditableComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter x:Name="SelectionPresenter"
                                                      Grid.Column="0"
                                                      Margin="10,0,6,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />

                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Margin="8,1,4,1"
                                             Padding="2,0"
                                             VerticalContentAlignment="Center"
                                             Background="Transparent"
                                             Foreground="{TemplateBinding Foreground}"
                                             BorderThickness="0"
                                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Visibility="Collapsed" />

                                    <ToggleButton x:Name="DropDownToggle"
                                                  Grid.Column="1"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="1,0,0,0"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <Path Width="8"
                                                          Height="5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="{DynamicResource TextPrimaryBrush}"
                                                          Data="M 0 0 L 4 4 L 8 0 Z" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="300"
                                        Margin="0,2,0,0"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="SelectionPresenter"
                                        Property="Visibility"
                                        Value="Collapsed" />
                                <Setter TargetName="PART_EditableTextBox"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder"
                                        Property="Opacity"
                                        Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EditorModeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="650" />
            <Setter Property="ToolTipService.ShowDuration" Value="1600" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ModeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="#252B38" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Document header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="DirtyText"
                               Text="● 未保存"
                               Margin="12,7,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource WarningBrush}"
                               Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="PathText"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="難易度"
                           Margin="0,0,7,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <ComboBox x:Name="DifficultyComboBox"
                          Width="105"
                          Margin="0,0,12,0"
                          Style="{DynamicResource DarkComboBoxStyle}"
                          SelectionChanged="DifficultyComboBox_SelectionChanged" />
                <Button Content="←"
                        Style="{StaticResource EditorIconButtonStyle}"
                        ToolTip="戻る"
                        Click="BackButton_Click" />
                <Button Content="作業保存"
                        Height="30"
                        Margin="4,0,0,0"
                        Padding="9,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        ToolTip="編集途中の状態をMusicXMLを変更せず保存  Ctrl+Shift+S"
                        Click="WorkspaceSaveButton_Click" />
                <Button Content="別名"
                        Width="48"
                        Height="30"
                        Margin="4,0,0,0"
                        Padding="6,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        ToolTip="名前を付けて保存"
                        Click="SaveAsButton_Click" />
                <Button Content="保存"
                        Height="30"
                        Margin="4,0,0,0"
                        Padding="10,0"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        ToolTip="保存  Ctrl+S"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Editing commands -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="8,6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <WrapPanel VerticalAlignment="Center">
                <Button x:Name="UndoButton"
                        Content="↶"
                        Style="{StaticResource EditorIconButtonStyle}"
                        ToolTip="Undo  Ctrl+Z"
                        Click="UndoButton_Click" />
                <Button x:Name="RedoButton"
                        Content="↷"
                        Style="{StaticResource EditorIconButtonStyle}"
                        ToolTip="Redo  Ctrl+Y"
                        Click="RedoButton_Click" />
                <Button Content="⧉"
                        Style="{StaticResource EditorIconButtonStyle}"
                        ToolTip="コピー  Ctrl+C"
                        Click="CopyButton_Click" />
                <Button Content="✂"
                        Style="{StaticResource EditorIconButtonStyle}"
                        ToolTip="切り取り  Ctrl+X"
                        Click="CutButton_Click" />
                <Button Content="▣"
                        Style="{StaticResource EditorIconButtonStyle}"
                        ToolTip="貼り付け  Ctrl+V"
                        Click="PasteButton_Click" />
                <Button Content="＋"
                        Style="{StaticResource EditorIconButtonStyle}"
                        ToolTip="複製  Ctrl+D"
                        Click="DuplicateButton_Click" />
                <Button Content="×"
                        Style="{StaticResource EditorIconButtonStyle}"
                        ToolTip="削除  Delete"
                        Click="DeleteButton_Click" />

                <Border Width="1" Height="24" Margin="7,0"
                        Background="{DynamicResource BorderBrush}" />

                <Button Content="÷2"
                        Style="{StaticResource EditorIconButtonStyle}"
                        ToolTip="選択ノートを2分割"
                        Click="SplitTwoButton_Click" />
                <Button Content="÷3"
                        Style="{StaticResource EditorIconButtonStyle}"
                        ToolTip="選択ノートを3分割"
                        Click="SplitThreeButton_Click" />

                <Border Width="1" Height="24" Margin="7,0"
                        Background="{DynamicResource BorderBrush}" />

                <TextBlock Text="挿入"
                           Margin="0,0,3,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <ToggleButton x:Name="InsertRightHandButton"
                              Content="R"
                              IsChecked="True"
                              Style="{StaticResource EditorModeToggleStyle}"
                              ToolTip="右手ノート挿入モード  R"
                              Click="InsertRightHandButton_Click" />
                <ToggleButton x:Name="InsertLeftHandButton"
                              Content="L"
                              Style="{StaticResource EditorModeToggleStyle}"
                              ToolTip="左手ノート挿入モード  L"
                              Click="InsertLeftHandButton_Click" />
                <Border Width="1" Height="24" Margin="7,0"
                        Background="{DynamicResource BorderBrush}" />

                <TextBlock Text="Grid"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <ComboBox x:Name="GridComboBox"
                          Width="96"
                          Height="30"
                          SelectedValuePath="Ticks"
                          Style="{DynamicResource DarkComboBoxStyle}"
                          SelectionChanged="GridComboBox_SelectionChanged" />

                <Border Width="1" Height="24" Margin="7,0"
                        Background="{DynamicResource BorderBrush}" />

                <TextBlock Text="Scale"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock x:Name="ScaleCurrentText"
                           MinWidth="126"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="現在: —" />
                <TextBlock Text="推定候補"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <ComboBox x:Name="ScaleCandidateComboBox"
                          Width="150"
                          Height="30"
                          DisplayMemberPath="Label"
                          Style="{DynamicResource DarkComboBoxStyle}"
                          ToolTip="候補を選び、「候補を適用」で現在小節から反映します。"
                          SelectionChanged="ScaleCandidateComboBox_SelectionChanged" />
                <Button Content="候補を適用"
                        Height="30"
                        Margin="4,0,0,0"
                        Padding="8,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        ToolTip="選択したScale候補を現在小節から反映"
                        Click="ApplyScaleCandidateButton_Click" />
                <Button x:Name="ScaleAdvancedButton"
                        Content="詳細指定…"
                        Height="30"
                        Margin="4,0,0,0"
                        Padding="8,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        ToolTip="TonicとScale種類を指定して設定"
                        Click="ScaleAdvancedButton_Click" />
                <ToggleButton x:Name="ScaleGuideToggleButton"
                              Content="Guide"
                              Width="54"
                              Style="{StaticResource EditorModeToggleStyle}"
                              ToolTip="Scale Guide  K"
                              Checked="ScaleGuideToggleButton_Changed"
                              Unchecked="ScaleGuideToggleButton_Changed" />
                <TextBlock x:Name="KeySourceText"
                           Margin="3,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <Border Width="1" Height="24" Margin="7,0"
                        Background="{DynamicResource BorderBrush}" />

                <TextBlock Text="MIDI Shift"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <ComboBox x:Name="OctaveShiftComboBox"
                          Width="100"
                          Height="30"
                          Style="{DynamicResource DarkComboBoxStyle}"
                          SelectionChanged="OctaveShiftComboBox_SelectionChanged" />
                <TextBlock x:Name="OctaveShiftStatusText"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </WrapPanel>
        </Border>

        <!-- Piano roll and note inspector -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#080A0F"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition x:Name="ReferenceAudioLaneColumn"
                                              Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:EditorMeasureLaneControl x:Name="MeasureLane"
                                                           Grid.Column="0"
                                                           CursorBeatRequested="MeasureLane_CursorBeatRequested"
                                                           HarmonyEditRequested="MeasureLane_HarmonyEditRequested"
                                                           ContextMenuOpening="MeasureLane_ContextMenuOpening"
                                                           PreviewMouseWheel="EditorRoll_PreviewMouseWheel">
                            <controls:EditorMeasureLaneControl.ContextMenu>
                                <ContextMenu Background="{DynamicResource SurfaceBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource BorderBrush}"
                                             Closed="MeasureLaneContextMenu_Closed">
                                    <MenuItem x:Name="MeasureContextInfoMenuItem"
                                              Header="小節"
                                              IsEnabled="False" />
                                    <Separator />
                                    <MenuItem x:Name="InsertMeasureBeforeMenuItem"
                                              Header="前に空小節を挿入"
                                              Click="InsertMeasureBeforeMenuItem_Click" />
                                    <MenuItem x:Name="InsertMeasureAfterMenuItem"
                                              Header="後に空小節を挿入"
                                              Click="InsertMeasureAfterMenuItem_Click" />
                                    <Separator />
                                    <MenuItem Header="拍子を変更…"
                                              Click="EditMeasureTimeSignatureMenuItem_Click" />
                                    <MenuItem Header="テンポを設定…"
                                              Click="EditMeasureTempoMenuItem_Click" />
                                    <MenuItem x:Name="RemoveMeasureTempoMenuItem"
                                              Header="この小節のテンポ変更を削除"
                                              Click="RemoveMeasureTempoMenuItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="DeleteMeasureMenuItem"
                                              Header="この小節を削除"
                                              Click="DeleteMeasureMenuItem_Click" />
                                </ContextMenu>
                            </controls:EditorMeasureLaneControl.ContextMenu>
                        </controls:EditorMeasureLaneControl>

                        <controls:EditorReferenceAudioLaneControl x:Name="ReferenceAudioLane"
                                                                        Grid.Column="1"
                                                                        Visibility="Collapsed"
                                                                        Focusable="True"
                                                                        SeekRequested="ReferenceAudioLane_SeekRequested"
                                                                        PlayRequested="ReferenceAudioLane_PlayRequested"
                                                                        SyncPointAddRequested="ReferenceAudioLane_SyncPointAddRequested"
                                                                        SyncPointSelected="ReferenceAudioLane_SyncPointSelected"
                                                                        SyncPointMoveRequested="ReferenceAudioLane_SyncPointMoveRequested"
                                                                        SyncPointDeleteRequested="ReferenceAudioLane_SyncPointDeleteRequested"
                                                                        AudioSegmentAdjustRequested="ReferenceAudioLane_AudioSegmentAdjustRequested"
                                                                        ToolTip="Shift+ドラッグ: 曲頭区間は開始位置を調整。同期点以降の区間は下方向=開始側、上方向=終了側を調整し、差分はカット区間として保持"
                                                                        PreviewMouseWheel="ReferenceAudioLane_PreviewMouseWheel" />

                        <controls:EditorPianoRollControl x:Name="EditorRoll"
                                                        Grid.Column="2"
                                                        Focusable="True"
                                                        GridTicks="{Binding SelectedValue, ElementName=GridComboBox}"
                                                        MouseDown="EditorRoll_MouseDown"
                                                        MouseUp="EditorRoll_MouseUp"
                                                        MouseLeftButtonDown="EditorRoll_MouseLeftButtonDown"
                                                        MouseLeftButtonUp="EditorRoll_MouseLeftButtonUp"
                                                        MouseMove="EditorRoll_MouseMove"
                                                        MouseLeave="EditorRoll_MouseLeave"
                                                        PreviewMouseWheel="EditorRoll_PreviewMouseWheel"
                                                        TimelineViewportChanged="EditorRoll_TimelineViewportChanged" />
                    </Grid>
                </Border>

                <!-- Viewport controls belong next to the viewport, not in the edit toolbar. -->
                <Border Grid.Row="1"
                        Margin="0,8,0,0"
                        Padding="10,6"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="表示音域"
                                       Margin="0,0,9,0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="◀"
                                    Padding="8,3"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    ToolTip="低音側へ6半音移動"
                                    ToolTipService.InitialShowDelay="650"
                                    ToolTipService.ShowDuration="1600"
                                    ToolTipService.BetweenShowDelay="250"
                                    Click="PitchPanLowerButton_Click" />
                            <Button Content="−"
                                    Margin="4,0,0,0"
                                    Padding="8,3"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    ToolTip="表示音域を広げる"
                                    ToolTipService.InitialShowDelay="650"
                                    ToolTipService.ShowDuration="1600"
                                    ToolTipService.BetweenShowDelay="250"
                                    Click="PitchZoomOutButton_Click" />
                            <Button Content="＋"
                                    Margin="4,0,0,0"
                                    Padding="8,3"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    ToolTip="表示音域を狭めて拡大する"
                                    ToolTipService.InitialShowDelay="650"
                                    ToolTipService.ShowDuration="1600"
                                    ToolTipService.BetweenShowDelay="250"
                                    Click="PitchZoomInButton_Click" />
                            <Button Content="▶"
                                    Margin="4,0,0,0"
                                    Padding="8,3"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    ToolTip="高音側へ6半音移動"
                                    ToolTipService.InitialShowDelay="650"
                                    ToolTipService.ShowDuration="1600"
                                    ToolTipService.BetweenShowDelay="250"
                                    Click="PitchPanHigherButton_Click" />
                            <Button Content="全体"
                                    Margin="7,0,0,0"
                                    Padding="10,3"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    ToolTip="曲を含む全音域へ戻す"
                                    ToolTipService.InitialShowDelay="650"
                                    ToolTipService.ShowDuration="1600"
                                    ToolTipService.BetweenShowDelay="250"
                                    Click="PitchResetButton_Click" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Cursor="Help"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="ⓘ 操作"
                                       ToolTipService.InitialShowDelay="250"
                                       ToolTipService.ShowDuration="12000"
                                       ToolTip="タイムライン: 小節番号側クリック=現在位置 / ドラッグ=時間移動 / 右クリック=小節・拍子・テンポ編集 / コード名ダブルクリック=追加・編集&#x0a;ピアノロール: Alt+左ドラッグ または 中ボタン=時間・音域パン / ホイール=時間移動 / Shift+ホイール=高速時間移動 / Ctrl+ホイール=時間ズーム / Ctrl+Shift+ホイール=上:曲末 / 下:曲頭 / Alt+ホイール=音域移動 / Alt+Shift+ホイール=音域ズーム&#x0a;ノート: ←→=半音 / Shift+←→=1オクターブ / Ctrl+←→=Scale内移動 / ↑↓=時間移動 / Shift+↑↓=長さ変更 / Home=曲頭 / End=曲末 / R/L=挿入手 / K=Scale Guide / H押下中=位置ごとのChord Tone" />
                        </StackPanel>

                        <StackPanel Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Top">
                                <ToggleButton x:Name="ReferenceAudioToggleButton"
                                              Content="元音源を使用"
                                              Style="{StaticResource EditorModeToggleStyle}"
                                              Checked="ReferenceAudioToggleButton_Changed"
                                              Unchecked="ReferenceAudioToggleButton_Changed" />
                                <StackPanel x:Name="ReferenceAudioControlsPanel"
                                            Margin="8,0,0,0"
                                            Visibility="Collapsed">
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button Content="音源選択…"
                                                Height="30"
                                                Padding="9,0"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Click="ReferenceAudioSelectButton_Click" />
                                        <TextBlock Text="再生"
                                                   Margin="8,0,4,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <ComboBox x:Name="ReferencePlaybackModeComboBox"
                                                  Width="92"
                                                  Height="30"
                                                  DisplayMemberPath="Label"
                                                  Style="{DynamicResource DarkComboBoxStyle}"
                                                  SelectionChanged="ReferencePlaybackModeComboBox_SelectionChanged" />
                                        <TextBlock Text="原音 Vol"
                                                   Margin="9,0,3,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <Slider x:Name="ReferenceAudioVolumeSlider"
                                                Width="60"
                                                Minimum="0"
                                                Maximum="100"
                                                VerticalAlignment="Center"
                                                ValueChanged="ReferenceAudioVolumeSlider_ValueChanged" />
                                        <TextBlock Text="Pan"
                                                   Margin="6,0,2,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <Slider x:Name="ReferenceAudioPanSlider"
                                                Width="64"
                                                Minimum="-100"
                                                Maximum="100"
                                                VerticalAlignment="Center"
                                                AutoToolTipPlacement="TopLeft"
                                                AutoToolTipPrecision="0"
                                                ToolTip="原音の左右定位: -100=左 / 0=中央 / +100=右"
                                                ValueChanged="ReferenceAudioPanSlider_ValueChanged" />
                                        <TextBlock Text="譜面 Vol"
                                                   Margin="8,0,3,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <Slider x:Name="ReferenceScoreVolumeSlider"
                                                Width="60"
                                                Minimum="0"
                                                Maximum="100"
                                                VerticalAlignment="Center"
                                                ValueChanged="ReferenceScoreVolumeSlider_ValueChanged" />
                                        <TextBlock Text="Pan"
                                                   Margin="6,0,2,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <Slider x:Name="ReferenceScorePanSlider"
                                                Width="64"
                                                Minimum="-100"
                                                Maximum="100"
                                                VerticalAlignment="Center"
                                                AutoToolTipPlacement="TopLeft"
                                                AutoToolTipPrecision="0"
                                                ToolTip="譜面試聴の左右定位: -100=左 / 0=中央 / +100=右"
                                                ValueChanged="ReferenceScorePanSlider_ValueChanged" />
                                        <Button Content="A/B比較  B"
                                                Height="30"
                                                Margin="10,0,0,0"
                                                Padding="10,0"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                ToolTip="範囲再生、選択箇所、または現在小節を原音→譜面の順で比較"
                                                Click="ReferenceAudioCompareButton_Click" />
                                        <TextBlock x:Name="ReferenceAudioStatusText"
                                                   Margin="9,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="音源未選択" />
                                    </WrapPanel>

                                    <WrapPanel Margin="0,4,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock Text="原音位置"
                                                   Margin="0,0,5,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                        <Slider x:Name="ReferenceAudioPositionSlider"
                                                Width="260"
                                                Minimum="0"
                                                Maximum="1"
                                                VerticalAlignment="Center"
                                                ValueChanged="ReferenceAudioPositionSlider_ValueChanged" />
                                        <TextBlock x:Name="ReferenceAudioTimeText"
                                                   MinWidth="88"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   Text="00:00.000" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Cursor="Help"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="ⓘ 波形操作"
                                                   ToolTipService.InitialShowDelay="250"
                                                   ToolTipService.ShowDuration="12000"
                                                   ToolTip="クリック=原音位置 / ダブルクリック=原音再生 / Alt+クリック=最寄りGridへ同期点追加（再生位置は移動しない）&#x0a;Shift+ドラッグ: 曲頭～最初の同期点=開始位置を調整 / 同期点以降は下方向=その区間の開始側、上方向=終了側を調整。最後の区間で上方向なら譜面終了位置を調整&#x0a;境界差は「カット」として保持し、同期再生では即時スキップ / 同期点: ドラッグ=譜面位置調整 / Shift+ホイール=原音±50ms / 右クリック・Delete=削除" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Margin="10,0,0,0"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style TargetType="TextBox">
                                <Setter Property="Height" Value="30" />
                                <Setter Property="Padding" Value="7,4" />
                                <Setter Property="Margin" Value="0,4,0,9" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock Text="ノート詳細"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="InspectorSelectionText"
                                   Margin="0,5,0,12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <TextBlock Text="MIDIノート" Style="{DynamicResource SectionLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InspectorMidiTextBox" Grid.Column="0" />
                            <TextBlock x:Name="InspectorPitchNameText"
                                       Grid.Column="1"
                                       MinWidth="42"
                                       Margin="8,0,0,5"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                        </Grid>

                        <TextBlock Text="開始位置 (beat)" Style="{DynamicResource SectionLabelStyle}" />
                        <TextBox x:Name="InspectorStartTextBox" />

                        <TextBlock Text="長さ (beat)" Style="{DynamicResource SectionLabelStyle}" />
                        <TextBox x:Name="InspectorDurationTextBox" />

                        <TextBlock Text="Voice" Style="{DynamicResource SectionLabelStyle}" />
                        <TextBox x:Name="InspectorVoiceTextBox" />

                        <TextBlock Text="指番号 (0=未指定)" Style="{DynamicResource SectionLabelStyle}" />
                        <TextBox x:Name="InspectorFingerTextBox" />

                        <TextBlock Text="手" Style="{DynamicResource SectionLabelStyle}" />
                        <ComboBox x:Name="InspectorHandComboBox"
                                  Height="34"
                                  Margin="0,4,0,10"
                                  Style="{DynamicResource DarkComboBoxStyle}" />

                        <TextBlock x:Name="InspectorTickText"
                                   Margin="0,0,0,8"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <Button x:Name="InspectorApplyButton"
                                Content="ノート情報を適用"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="InspectorApplyButton_Click" />
                        <TextBlock x:Name="InspectorMessageText"
                                   Margin="0,9,0,0"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Preview transport -->
        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="試聴"
                           Margin="2,0,10,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="RangePreviewCheckBox"
                              Content="範囲再生"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Checked="RangePreviewCheckBox_Changed"
                              Unchecked="RangePreviewCheckBox_Changed" />
                    <Button Content="現在位置周辺"
                            Margin="10,0,0,0"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Click="SetCursorPreviewButton_Click" />
                    <Button Content="選択周辺"
                            Margin="6,0,0,0"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Click="SetSelectionPreviewButton_Click" />
                    <TextBlock Text="前"
                               Margin="10,0,4,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox x:Name="PreviewBeforeMeasureComboBox"
                              Width="62"
                              Style="{DynamicResource DarkComboBoxStyle}"
                              SelectionChanged="PreviewMeasureCountComboBox_SelectionChanged" />
                    <TextBlock Text="後"
                               Margin="7,0,4,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox x:Name="PreviewAfterMeasureComboBox"
                              Width="62"
                              Style="{DynamicResource DarkComboBoxStyle}"
                              SelectionChanged="PreviewMeasureCountComboBox_SelectionChanged" />
                    <TextBlock x:Name="PreviewRangeText"
                               Margin="10,0,0,0"
                               MinWidth="150"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="範囲再生: OFF" />
                </StackPanel>

                <Border Grid.Column="2"
                        Width="1"
                        Height="24"
                        Margin="12,0"
                        Background="{DynamicResource BorderBrush}" />

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="LoopCheckBox"
                              Content="ループ"
                              IsEnabled="False"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button x:Name="PreviewButton"
                            Content="▶ 試聴  Space"
                            Margin="10,0,0,0"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Click="PreviewButton_Click" />
                    <Button Content="■ 停止"
                            Margin="6,0,0,0"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Click="StopPreviewButton_Click" />
                </StackPanel>

                <TextBlock x:Name="StatusText"
                           Grid.Column="4"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>
        <Popup x:Name="MeasureTimeSignaturePopup"
               PlacementTarget="{Binding ElementName=MeasureLane}"
               Placement="Relative"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               Closed="MeasurePropertyPopup_Closed">
            <Border Width="250"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="MeasureTimeSignatureTitleText"
                               Text="拍子を変更"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="MeasureTimeSignatureCurrentText"
                               Margin="0,3,0,10"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="拍子"
                               Margin="0,0,0,4"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="MeasureBeatsTextBox"
                                 Width="78"
                                 Height="32"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource SurfaceRaisedBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 KeyDown="MeasureTimeSignatureTextBox_KeyDown" />
                        <TextBlock Text="/"
                                   Margin="8,0"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox x:Name="MeasureBeatTypeTextBox"
                                 Width="78"
                                 Height="32"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"
                                 Background="{DynamicResource SurfaceRaisedBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 KeyDown="MeasureTimeSignatureTextBox_KeyDown" />
                    </StackPanel>
                    <TextBlock Text="例: 4/4、3/4、6/8"
                               Margin="0,6,0,10"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Button Content="拍子を適用"
                            HorizontalAlignment="Right"
                            Padding="14,5"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Click="ApplyMeasureTimeSignatureButton_Click" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="MeasureTempoPopup"
               PlacementTarget="{Binding ElementName=MeasureLane}"
               Placement="Relative"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               Closed="MeasurePropertyPopup_Closed">
            <Border Width="250"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="MeasureTempoTitleText"
                               Text="テンポを設定"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="MeasureTempoCurrentText"
                               Margin="0,3,0,10"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="BPM"
                               Margin="0,0,0,4"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBox x:Name="MeasureTempoTextBox"
                             Height="32"
                             Padding="8,4"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource SurfaceRaisedBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             KeyDown="MeasureTempoTextBox_KeyDown" />
                    <Button Content="テンポを設定"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Padding="14,5"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Click="ApplyMeasureTempoButton_Click" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="HarmonyEditorPopup"
               PlacementTarget="{Binding ElementName=MeasureLane}"
               Placement="Relative"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               Closed="HarmonyEditorPopup_Closed">
            <Border Width="300"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="HarmonyPopupTitleText"
                               Text="コードを変更"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="HarmonyPopupPositionText"
                               Margin="0,3,0,8"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <Border Margin="0,0,0,10"
                            Padding="9,7"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource AccentTextBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <StackPanel>
                            <TextBlock x:Name="HarmonyTargetCodeText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="HarmonyTargetRangeText"
                                       Margin="0,3,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="コード"
                               Margin="0,0,0,4"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <ComboBox x:Name="ChordComboBox"
                              Height="32"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              StaysOpenOnEdit="True"
                              Style="{StaticResource EditorEditableComboBoxStyle}"
                              ToolTip="候補から選択、またはコード名を直接入力"
                              KeyDown="ChordComboBox_KeyDown" />
                    <TextBlock x:Name="ChordSourceText"
                               Margin="0,5,0,10"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="RemoveChordButton"
                                Content="削除"
                                Margin="0,0,6,0"
                                Padding="12,4"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="RemoveChordButton_Click" />
                        <Button x:Name="ApplyChordButton"
                                Content="変更"
                                Padding="14,4"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="ApplyChordButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="ScaleAdvancedPopup"
               PlacementTarget="{Binding ElementName=ScaleAdvancedButton}"
               Placement="Bottom"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade">
            <Border Width="280"
                    Margin="0,5,0,0"
                    Padding="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Scale 詳細指定"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,3,0,10"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="TonicとScale種類を指定し、現在小節から反映します。" />
                    <TextBlock Text="Tonic"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="ScaleTonicComboBox"
                              Height="30"
                              Margin="0,4,0,9"
                              DisplayMemberPath="Label"
                              Style="{DynamicResource DarkComboBoxStyle}" />
                    <TextBlock Text="Scale種類"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="ScaleTypeComboBox"
                              Height="30"
                              Margin="0,4,0,10"
                              DisplayMemberPath="DisplayName"
                              Style="{DynamicResource DarkComboBoxStyle}"
                              SelectionChanged="ScaleTypeComboBox_SelectionChanged" />
                    <Button Content="この小節から適用"
                            HorizontalAlignment="Right"
                            Padding="12,4"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Click="ApplyKeySignatureButton_Click" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>