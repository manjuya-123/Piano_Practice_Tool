<UserControl x:Class="PianoPracticeTool.Views.SongMetadataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="MetadataTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="← 曲選択"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="BackButton_Click" />
            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <TextBlock Text="曲情報編集"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="FilePathText"
                           Margin="0,4,0,0"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Margin="0,0,8,0"
                    Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="基本情報"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBlock Text="曲名"
                               Margin="0,14,0,5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="TitleTextBox"
                             Style="{StaticResource MetadataTextBoxStyle}" />

                    <TextBlock Text="作曲者"
                               Margin="0,14,0,5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox x:Name="ComposerTextBox"
                             Style="{StaticResource MetadataTextBoxStyle}" />

                    <TextBlock Text="難易度"
                               Margin="0,14,0,5"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="DifficultyComboBox"
                              Height="34"
                              DisplayMemberPath="Label"
                              Style="{DynamicResource DarkComboBoxStyle}" />

                    <TextBlock Margin="0,14,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="変更した曲情報はMusicXMLファイルへ保存され、次回の読み込みにも反映されます。" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="8,0,0,0"
                    Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Scale / Key"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="CurrentScaleText"
                               Margin="0,6,0,14"
                               Foreground="{DynamicResource AccentTextBrush}" />

                    <TextBlock Text="Tonic"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="ScaleTonicComboBox"
                              Height="34"
                              Margin="0,5,0,12"
                              DisplayMemberPath="Label"
                              Style="{DynamicResource DarkComboBoxStyle}"
                              SelectionChanged="ScaleSelection_Changed" />

                    <TextBlock Text="Scale種類"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ComboBox x:Name="ScaleTypeComboBox"
                              Height="34"
                              Margin="0,5,0,12"
                              DisplayMemberPath="DisplayName"
                              Style="{DynamicResource DarkComboBoxStyle}"
                              SelectionChanged="ScaleTypeComboBox_SelectionChanged" />

                    <Border Padding="10,8"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock x:Name="ScaleSaveStateText"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="TonicまたはScale種類を変更すると、保存時に曲頭のKey / Scaleへ反映します。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Grid.Column="1"
                    Content="曲情報を保存"
                    MinWidth="150"
                    Padding="18,9"
                    Style="{DynamicResource PrimaryButtonStyle}"
                    Click="SaveButton_Click" />
        </Grid>
    </Grid>
</UserControl>
