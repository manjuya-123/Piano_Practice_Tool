<UserControl x:Class="PianoPracticeTool.Views.PracticeSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ModeCardStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Padding="{TemplateBinding Padding}" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#1C2230" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#202742" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HandOptionStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Option" MinWidth="90" Padding="14,9" CornerRadius="7" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Option" Property="Background" Value="#252B38" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Option" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Option" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Content="← 曲選択" Style="{DynamicResource SecondaryButtonStyle}" Click="BackButton_Click" />
            <StackPanel Grid.Column="1" Margin="18,0,0,0">
                <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="SongInfoText" Margin="0,5,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Border x:Name="SongCompressionBadge"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        CornerRadius="7"
                        Background="#263B32"
                        BorderBrush="{DynamicResource SuccessBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <TextBlock Text="楽曲圧縮 ON"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessBrush}" />
                </Border>
                <Border Padding="12,6"
                        CornerRadius="7"
                        Background="{DynamicResource SurfaceRaisedBrush}">
                    <TextBlock x:Name="KeyboardStatusText"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" Margin="0,0,16,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="練習モード" Margin="0,0,0,8" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="カードを直接選択してください。待機練習と通常練習では演奏パートも選べます。" Margin="0,0,0,12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <RadioButton x:Name="WaitModeRadio" Grid.Column="0" GroupName="PracticeMode" Margin="0,0,8,0" Style="{StaticResource ModeCardStyle}" Checked="PracticeMode_Checked">
                            <StackPanel><TextBlock Text="待機練習" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="正しい鍵盤を弾くまで進行を待機。誤キーを減らす練習。" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PlayAlongModeRadio" Grid.Column="1" GroupName="PracticeMode" Margin="0,0,8,0" Style="{StaticResource ModeCardStyle}" Checked="PracticeMode_Checked">
                            <StackPanel><TextBlock Text="通常練習" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="流れるノートに合わせ、タイミング・誤キー・見逃しを採点。" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="OriginalTempoModeRadio" Grid.Column="2" GroupName="PracticeMode" Style="{StaticResource ModeCardStyle}" Checked="PracticeMode_Checked">
                            <StackPanel><TextBlock Text="原曲テンポ" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="楽譜のテンポで両手演奏し、タイミング・誤キー・見逃しを採点します。" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                        </RadioButton>
                    </Grid>

                    <Border x:Name="HandSelectionPanel" Margin="0,12,0,0" Style="{DynamicResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="演奏パート" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="練習する手を直接選択" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <RadioButton x:Name="BothHandRadio" Content="両手" GroupName="PracticeHand" Style="{StaticResource HandOptionStyle}" Checked="HandMode_Checked" />
                                <RadioButton x:Name="RightHandRadio" Content="右手" GroupName="PracticeHand" Style="{StaticResource HandOptionStyle}" Checked="HandMode_Checked" />
                                <RadioButton x:Name="LeftHandRadio" Content="左手" GroupName="PracticeHand" Style="{StaticResource HandOptionStyle}" Checked="HandMode_Checked" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="14" CornerRadius="8" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="KeyboardPlanText" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="HandWarningText" Margin="0,5,0,0" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                            <Grid x:Name="DeviceOctaveShiftControlsPanel" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MIDIデバイス側オクターブシフト" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <WrapPanel x:Name="DeviceOctaveShiftOptionsPanel" Grid.Column="1" VerticalAlignment="Center" />
                                <TextBlock x:Name="AppliedDeviceOctaveShiftText" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                            </Grid>
                            <TextBlock x:Name="DeviceOctaveShiftHintText" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Text="MIDIキーボード本体のオクターブシフト量を選びます。楽曲圧縮を使う場合は曲選択画面で設定します。" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{DynamicResource CardBorderStyle}">
                        <StackPanel>
                            <CheckBox x:Name="LoopEnabledCheckBox" Content="練習範囲を指定する" Foreground="{DynamicResource TextPrimaryBrush}" Checked="LoopEnabledCheckBox_Changed" Unchecked="LoopEnabledCheckBox_Changed" />
                            <Grid x:Name="LoopPanel" Margin="0,12,0,0" IsEnabled="False">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="LoopStartComboBox" DisplayMemberPath="Label" Style="{DynamicResource DarkComboBoxStyle}" />
                                <TextBlock Grid.Column="1" Text="→" Margin="9,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                                <ComboBox x:Name="LoopEndComboBox" Grid.Column="2" DisplayMemberPath="Label" Style="{DynamicResource DarkComboBoxStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="16" CornerRadius="10" Background="#111722" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="お手本再生" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="練習ではなく、原曲の流れや運指を確認するための再生モードです。" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                            <Button Grid.Column="1" Content="お手本を再生" Margin="20,0,0,0" VerticalAlignment="Center" Style="{DynamicResource SecondaryButtonStyle}" Click="ListenButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{DynamicResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="この条件の練習記録" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="HistorySummaryText" Grid.Row="1" Margin="0,6,0,12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Grid Grid.Row="2" Margin="0,0,0,4" Background="{DynamicResource SurfaceRaisedBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="日時" Padding="8,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="スコア" Padding="8,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Grid.Column="2" Text="テンポ" Padding="8,6" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="HistoryItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DateText}" Padding="8,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ScoreText}" Padding="8,6" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding TempoText}" Padding="8,6" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="SetupHintText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button x:Name="StartPracticeButton" Grid.Column="1" Content="練習開始" MinWidth="150" Padding="20,11" Style="{DynamicResource PrimaryButtonStyle}" Click="StartButton_Click" />
        </Grid>
    </Grid>
</UserControl>
