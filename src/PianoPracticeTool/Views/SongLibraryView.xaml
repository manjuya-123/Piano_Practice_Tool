<UserControl x:Class="PianoPracticeTool.Views.SongLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="DifficultyFilterStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip"
                                Padding="11,7"
                                CornerRadius="7"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#252B38" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="楽曲ライブラリ"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="曲を選択して練習条件へ進みます。曲名・作曲者・難易度・Scaleは「曲情報」から編集できます。"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="再読込"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="RefreshButton_Click" />
                <Button Content="MusicXMLを開く"
                        Margin="10,0,0,0"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Click="OpenFileButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="検索"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,10,0" />
                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="14"
                                 TextChanged="SearchTextBox_TextChanged" />
                    </Grid>
                </Border>
                <TextBlock x:Name="SongCountText"
                           Grid.Column="1"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>

            <StackPanel Grid.Row="1"
                        Margin="0,10,0,0"
                        Orientation="Horizontal">
                <RadioButton x:Name="AllDifficultyFilter" Content="すべて" GroupName="DifficultyFilter" IsChecked="True" Style="{StaticResource DifficultyFilterStyle}" Checked="DifficultyFilter_Checked" />
                <RadioButton x:Name="IntroductoryDifficultyFilter" Content="入門" GroupName="DifficultyFilter" Style="{StaticResource DifficultyFilterStyle}" Checked="DifficultyFilter_Checked" />
                <RadioButton x:Name="BeginnerDifficultyFilter" Content="初級" GroupName="DifficultyFilter" Style="{StaticResource DifficultyFilterStyle}" Checked="DifficultyFilter_Checked" />
                <RadioButton x:Name="IntermediateDifficultyFilter" Content="中級" GroupName="DifficultyFilter" Style="{StaticResource DifficultyFilterStyle}" Checked="DifficultyFilter_Checked" />
                <RadioButton x:Name="AdvancedDifficultyFilter" Content="上級" GroupName="DifficultyFilter" Style="{StaticResource DifficultyFilterStyle}" Checked="DifficultyFilter_Checked" />
                <RadioButton x:Name="UnknownDifficultyFilter" Content="未分類" GroupName="DifficultyFilter" Style="{StaticResource DifficultyFilterStyle}" Checked="DifficultyFilter_Checked" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="SongListView"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      MouseDoubleClick="SongListView_MouseDoubleClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,5" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardBorderStyle}"
                                Padding="11,8"
                                ToolTip="{Binding CardToolTip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Song.Title}"
                                                   MaxWidth="360"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ComposerText}"
                                                   Margin="9,1,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <ItemsControl ItemsSource="{Binding AvailabilityTags}"
                                                      Margin="10,0,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,5,0"
                                                            Padding="7,2"
                                                            CornerRadius="5"
                                                            Background="{Binding Background}"
                                                            ToolTip="{Binding ToolTip}">
                                                        <TextBlock Text="{Binding Text}"
                                                                   Foreground="{Binding Foreground}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Margin="2,0,0,0"
                                                Padding="5,1"
                                                CornerRadius="5"
                                                Background="#33FF6B81"
                                                Visibility="{Binding ConsistencyWarningVisibility}"
                                                ToolTip="{Binding ConsistencyWarningToolTip}">
                                            <TextBlock Text="⚠"
                                                       Foreground="#FF8A9B"
                                                       FontSize="12"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>

                                    <WrapPanel Grid.Row="1"
                                               Margin="0,5,0,0">
                                        <TextBlock Text="{Binding DifficultyText}"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding Song.TempoText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding Song.DurationText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding Song.RangeText}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding Song.ScaleText}"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding BestScoreText}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                    </WrapPanel>
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            Margin="16,0,0,0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="曲情報"
                                            Tag="{Binding}"
                                            Padding="10,6"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Click="MetadataButton_Click" />
                                    <Button Content="{Binding CompressionButtonText}"
                                            Tag="{Binding}"
                                            Margin="6,0,0,0"
                                            Padding="10,6"
                                            Visibility="{Binding CompressionVisibility}"
                                            IsEnabled="{Binding CanUseCompression}"
                                            ToolTip="{Binding CompressionToolTip}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Click="CompressionButton_Click" />
                                    <Button Content="{Binding ScoreCorrectionButtonText}"
                                            Tag="{Binding}"
                                            Margin="6,0,0,0"
                                            Padding="10,6"
                                            Visibility="{Binding ScoreCorrectionVisibility}"
                                            IsEnabled="{Binding CanUseScoreCorrection}"
                                            ToolTip="{Binding ScoreCorrectionToolTip}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Click="ScoreCorrectionButton_Click" />
                                    <Button Content="練習設定"
                                            Tag="{Binding}"
                                            Margin="6,0,0,0"
                                            Padding="12,6"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            Click="StartPracticeButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="条件に一致する曲がありません" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="検索語または難易度フィルタを変更してください。" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <Border x:Name="WarningPanel" Grid.Row="3" Margin="0,10,0,0" Background="#33291A" BorderBrush="#725628" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="Collapsed">
            <TextBlock x:Name="WarningText" Foreground="#FFD38A" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
