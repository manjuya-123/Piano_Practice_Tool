<UserControl x:Class="PianoPracticeTool.Views.PracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PianoPracticeTool.Controls"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Content="← 楽曲一覧"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="BackButton_Click" />

            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SongSummaryText"
                           Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Column="2"
                    Background="#252B3A"
                    CornerRadius="6"
                    Padding="10,6"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="KeyboardText"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource AccentTextBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="KeyboardMinimumText"
                               Margin="0,2,0,0"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="10" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="練習モード" Style="{DynamicResource SectionLabelStyle}" />
                        <ComboBox x:Name="PracticeModeComboBox"
                                  Width="150"
                                  Margin="0,4,0,0"
                                  DisplayMemberPath="Label"
                                  Style="{DynamicResource DarkComboBoxStyle}"
                                  SelectionChanged="PracticeModeComboBox_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="練習パート" Style="{DynamicResource SectionLabelStyle}" />
                        <ComboBox x:Name="HandModeComboBox"
                                  Width="110"
                                  Margin="0,4,0,0"
                                  DisplayMemberPath="Label"
                                  Style="{DynamicResource DarkComboBoxStyle}"
                                  SelectionChanged="HandModeComboBox_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Width="230" Margin="0,0,18,0">
                        <Grid>
                            <TextBlock Text="演奏速度" Style="{DynamicResource SectionLabelStyle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="SpeedValueText"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="  •  " Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                <TextBlock x:Name="CurrentBpmText"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                        <Slider x:Name="SpeedSlider"
                                Minimum="50"
                                Maximum="200"
                                Value="100"
                                TickFrequency="10"
                                SmallChange="10"
                                LargeChange="10"
                                IsSnapToTickEnabled="True"
                                Margin="0,7,0,0"
                                ToolTip="楽曲のテンポを50%～200%で変更"
                                ValueChanged="SpeedSlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Width="190" Margin="0,0,18,0">
                        <Grid>
                            <TextBlock Text="表示範囲" Style="{DynamicResource SectionLabelStyle}" />
                            <TextBlock x:Name="PianoRollVisibleRangeValueText"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <Slider x:Name="PianoRollVisibleRangeSlider"
                                Minimum="50"
                                Maximum="200"
                                Value="100"
                                TickFrequency="10"
                                SmallChange="10"
                                LargeChange="10"
                                IsSnapToTickEnabled="True"
                                Margin="0,7,0,0"
                                ToolTip="テンポとは独立して、一画面に表示するbeat範囲を変更"
                                ValueChanged="PianoRollVisibleRangeSlider_ValueChanged" />
                    </StackPanel>

                    <StackPanel Width="110" Margin="0,0,18,0">
                        <TextBlock Text="運指表示" Style="{DynamicResource SectionLabelStyle}" />
                        <CheckBox x:Name="FingeringDisplayCheckBox"
                                  Content="表示する"
                                  IsChecked="True"
                                  Margin="0,10,0,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  ToolTip="落下ノート上の運指番号を表示 / 非表示"
                                  Checked="FingeringDisplayCheckBox_Changed"
                                  Unchecked="FingeringDisplayCheckBox_Changed" />
                    </StackPanel>

                    <StackPanel Width="210" Margin="0,0,18,0">
                        <Grid>
                            <TextBlock Text="カウント / メトロノーム音量" Style="{DynamicResource SectionLabelStyle}" />
                            <TextBlock x:Name="MetronomeVolumeValueText"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <Slider x:Name="MetronomeVolumeSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="100"
                                TickFrequency="10"
                                SmallChange="10"
                                LargeChange="10"
                                IsSnapToTickEnabled="True"
                                Margin="0,7,0,0"
                                ToolTip="開始前カウント音と演奏中メトロノームの共通音量"
                                ValueChanged="MetronomeVolumeSlider_ValueChanged" />
                        <CheckBox x:Name="MetronomeCheckBox"
                                  Content="演奏中メトロノーム"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,5,0,0"
                                  Checked="MetronomeCheckBox_Changed"
                                  Unchecked="MetronomeCheckBox_Changed" />
                    </StackPanel>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="区間ループ" Style="{DynamicResource SectionLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="LoopEnabledCheckBox"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Checked="LoopSetting_Changed"
                                      Unchecked="LoopSetting_Changed" />
                            <ComboBox x:Name="LoopStartComboBox"
                                      Width="92"
                                      DisplayMemberPath="Label"
                                      Style="{DynamicResource DarkComboBoxStyle}"
                                      SelectionChanged="LoopSetting_Changed" />
                            <TextBlock Text="→" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                            <ComboBox x:Name="LoopEndComboBox"
                                      Width="92"
                                      DisplayMemberPath="Label"
                                      Style="{DynamicResource DarkComboBoxStyle}"
                                      SelectionChanged="LoopSetting_Changed" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="TransposePanel" Margin="0,0,16,0" Visibility="Collapsed">
                        <TextBlock Text="省鍵盤モード" Style="{DynamicResource SectionLabelStyle}" />
                        <CheckBox x:Name="InputTransposeCheckBox"
                                  Margin="0,10,0,0"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Checked="InputTransposeCheckBox_Changed"
                                  Unchecked="InputTransposeCheckBox_Changed" />
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,5">
                        <TextBlock x:Name="SoundStatusText"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </WrapPanel>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="状態" Style="{DynamicResource SectionLabelStyle}" />
                        <TextBlock x:Name="PracticeStatusText"
                                   Margin="0,3,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock Text="次の音" Style="{DynamicResource SectionLabelStyle}" />
                        <TextBlock x:Name="ExpectedNotesText"
                                   Margin="0,2,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="判定 / 進捗" Style="{DynamicResource SectionLabelStyle}" />
                            <TextBlock x:Name="PracticeProgressText"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                        <TextBlock x:Name="AccuracyText"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="PracticeProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="8"
                                     Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center">
                        <Button x:Name="PlayPauseButton"
                                Content="開始"
                                MinWidth="88"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Click="PlayPauseButton_Click" />
                        <Button x:Name="ResetPracticeButton"
                                Content="最初から"
                                Margin="8,0,0,0"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Click="ResetButton_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="#080A0F"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                ClipToBounds="True">
            <Grid>
                <controls:PianoRollControl x:Name="PianoRoll" />

                <Border x:Name="JudgementOverlay"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,24,0,0"
                        Padding="18,10"
                        Background="#D911151D"
                        BorderBrush="#4A5468"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="JudgementActionText"
                                   HorizontalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="JudgementText"
                                   Margin="0,1,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="30"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="ComboOverlayText"
                                   Margin="0,2,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeText"
                           Width="52"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Slider x:Name="TimelineSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="1"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp" />
                <TextBlock x:Name="PositionText"
                           Grid.Column="2"
                           Margin="10,0,14,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock x:Name="TotalTimeText"
                           Grid.Column="3"
                           Width="52"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <Expander Grid.Row="4"
                  Header="運指編集・楽曲詳細"
                  Margin="0,8,0,0"
                  Foreground="{DynamicResource TextSecondaryBrush}">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8"
                    Margin="0,8,0,0"
                    MaxHeight="250">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PathText"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="4,2,4,8" />
                        <TextBlock x:Name="HandSpanWarningText"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="11"
                                   Margin="12,2,4,8" />
                    </Grid>
                    <DataGrid x:Name="NoteGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              Background="#161A22"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderThickness="0"
                              RowBackground="#161A22"
                              AlternatingRowBackground="#1D222C"
                              GridLinesVisibility="Horizontal"
                              CellEditEnding="NoteGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Beat" Binding="{Binding StartBeat, StringFormat=F2}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="Pitch" Binding="{Binding PitchName}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="MIDI" Binding="{Binding MidiNote}" IsReadOnly="True" Width="70" />
                            <DataGridTextColumn Header="Hand" Binding="{Binding Hand}" IsReadOnly="True" Width="90" />
                            <DataGridTextColumn Header="Finger (1-5)" Binding="{Binding Finger, UpdateSourceTrigger=LostFocus}" Width="110" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationBeat, StringFormat=F2}" IsReadOnly="True" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Expander>
    </Grid>
</UserControl>
