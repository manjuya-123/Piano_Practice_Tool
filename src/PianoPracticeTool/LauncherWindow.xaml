<Window x:Class="PianoPracticeTool.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piano Practice Tool"
        Icon="Assets/AppIcon.ico"
        Height="620"
        Width="980"
        MinHeight="560"
        MinWidth="820"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="42">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Piano Practice Tool"
                       HorizontalAlignment="Center"
                       FontSize="34"
                       FontWeight="SemiBold" />
            <TextBlock Text="使用するモードを選択してください"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,38,0,38">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="P" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="練習モード" Margin="0,18,0,0" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="待機練習、通常練習、原曲テンポ、採点と練習履歴を使用します。"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Row="2"
                            Content="練習を開始"
                            Margin="0,24,0,0"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Click="PracticeButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource SuccessBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="E" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="#08100B" />
                        </Border>
                        <TextBlock Text="編集モード" Margin="0,18,0,0" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="MusicXMLのノートを選択・移動・分割・追加し、編集箇所を範囲試聴して保存します。"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Row="2"
                            Content="楽譜を編集"
                            Margin="0,24,0,0"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Click="EditorButton_Click" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="MIDI機器や音源、楽曲フォルダは右下の「設定」から変更できます。"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="11" />
            <Button Grid.Column="1"
                    Content="⚙ 設定"
                    Padding="14,7"
                    Style="{DynamicResource SecondaryButtonStyle}"
                    Click="SettingsButton_Click" />
        </Grid>
    </Grid>
</Window>
